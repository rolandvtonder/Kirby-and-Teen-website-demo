---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import {faqSchema} from '../lib/schema';
import {hours, site, whatsappLink} from '../data/site';
import {services} from '../data/services';

const crumbs = [{name: 'Book', href: '/book/'}];
const faqs = [
  {q: 'Is my booking confirmed when I send the message?', a: 'Not yet — we will reply on WhatsApp with available times and confirm your appointment once you have chosen one.'},
  {q: 'How far ahead should I book?', a: 'Weekends and the weeks before holidays fill up first, so book a week or two ahead for Saturdays and festive season. For weekdays, a few days is often enough.'},
  {q: 'What if I need to change my appointment?', a: `Please let us know as early as you can on WhatsApp or by calling ${site.phoneDisplay}, so we can offer your slot to someone else.`},
  {q: 'I have products from another salon — can you remove them?', a: 'Yes. Mention it in your booking message so we can allow time for a gentle soak-off.'},
];
---

<Base
  title="Book an Appointment on WhatsApp"
  description="Book nails, pedicures, lashes, brows, waxing or massage at Kirby and Teen, Table View. Pick your treatment and day, then send it on WhatsApp."
  crumbs={crumbs}
  schema={[faqSchema(faqs)]}
>
  <PageHero
    eyebrow="Book · Takes a minute"
    lines={[{t: 'Your chair'}, {t: 'is waiting.', i: true}]}
    intro="Choose your treatments and a day that suits you. We will write the WhatsApp message for you — just press send and we will reply with open times."
    image="baby-french-almond-nails"
    crumbs={crumbs}
  />

  <section class="bg-paper py-20 md:py-28" aria-labelledby="form-title">
    <div class="mx-auto grid max-w-[1680px] gap-14 px-5 md:grid-cols-12 md:px-14">
      <div class="md:col-span-4">
        <h2 id="form-title" class="display text-[clamp(40px,4.6vw,80px)]">Booking <span class="it">request</span></h2>
        <ol class="mt-8 space-y-5 text-muted">
          <li class="flex gap-4"><span class="caps text-ink">01</span>Pick one or more treatments.</li>
          <li class="flex gap-4"><span class="caps text-ink">02</span>Tell us when suits you.</li>
          <li class="flex gap-4"><span class="caps text-ink">03</span>Send on WhatsApp — we confirm your time.</li>
        </ol>
        <div class="mt-10 border-t border-ink/15 pt-8">
          <p class="caps text-muted">Prefer to talk?</p>
          <a href={`tel:${site.phoneIntl}`} class="display mt-2 block text-[36px] hover:text-cocoa">{site.phoneDisplay}</a>
          <dl class="mt-6 max-w-xs space-y-1 text-muted">
            {hours.map((h) => <div class="flex justify-between gap-6"><dt>{h.days}</dt><dd class="text-ink">{h.time}</dd></div>)}
          </dl>
        </div>
      </div>

      <form class="space-y-10 md:col-span-7 md:col-start-6" data-book novalidate>
        <fieldset>
          <legend class="caps text-ink">Treatments <span class="text-muted">(choose at least one)</span></legend>
          <div class="mt-5 space-y-8">
            {
              services.map((s) => (
                <div>
                  <p class="display text-[28px]">{s.name}</p>
                  <div class="mt-3 flex flex-wrap gap-2">
                    {s.groups.flatMap((g) => g.items).map((t) => (
                      <label class="pick">
                        <input type="checkbox" name="treatment" value={t.name} class="sr-only" />
                        <span>{t.name}</span>
                      </label>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
          <p class="mt-4 hidden text-[15px] font-medium text-cocoa" data-error role="alert">Please choose at least one treatment.</p>
        </fieldset>

        <div class="grid gap-6 md:grid-cols-2">
          <div>
            <label for="date" class="caps block text-ink">Preferred date</label>
            <input id="date" name="date" type="date" class="field mt-2" />
          </div>
          <div>
            <label for="time" class="caps block text-ink">Time of day</label>
            <select id="time" name="time" class="field mt-2">
              <option value="">Any time</option>
              <option>Morning</option>
              <option>Midday</option>
              <option>Afternoon</option>
            </select>
          </div>
          <div>
            <label for="name" class="caps block text-ink">Your name</label>
            <input id="name" name="name" type="text" autocomplete="given-name" class="field mt-2" />
          </div>
          <div>
            <label for="people" class="caps block text-ink">How many people?</label>
            <select id="people" name="people" class="field mt-2">
              <option>Just me</option>
              <option>2 people</option>
              <option>3 people</option>
              <option>4 or more</option>
            </select>
          </div>
          <div class="md:col-span-2">
            <label for="notes" class="caps block text-ink">Anything else? <span class="text-muted">(optional)</span></label>
            <textarea id="notes" name="notes" rows="4" class="field mt-2" placeholder="e.g. almond shape, soak-off needed, a photo of the design I'd like…"></textarea>
            <p class="mt-2 text-[15px] text-muted">Have an inspiration photo? You can attach it in WhatsApp after the message opens.</p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-5">
          <button type="submit" class="btn btn-ink">Send on WhatsApp</button>
          <a href={whatsappLink()} class="text-muted underline underline-offset-4" target="_blank" rel="noopener">or open a blank chat</a>
        </div>
        <p class="text-[15px] text-muted">Nothing is stored on this website. Your message goes straight from your phone to ours.</p>
      </form>
    </div>
  </section>

  <Faq faqs={faqs} title="Before you book" />
</Base>

<style>
  .pick span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border: 1px solid rgb(26 21 18 / 0.22);
    font-size: 15px;
    transition:
      background-color 0.25s,
      color 0.25s,
      border-color 0.25s;
  }
  .pick:hover span {
    border-color: var(--color-ink);
  }
  .pick input:checked + span {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }
  .pick input:focus-visible + span {
    outline: 2px solid var(--color-brass);
    outline-offset: 3px;
  }
  .field {
    width: 100%;
    min-height: 48px;
    padding: 0.7rem 0.9rem;
    background: #fff;
    border: 1px solid rgb(26 21 18 / 0.25);
    font-size: 16px;
    color: var(--color-ink);
  }
  .field:focus {
    outline: 2px solid var(--color-brass);
    outline-offset: 1px;
  }
</style>

<script>
  import {site} from '../data/site';

  const form = document.querySelector<HTMLFormElement>('[data-book]')!;
  const error = form.querySelector<HTMLElement>('[data-error]')!;
  const date = form.querySelector<HTMLInputElement>('#date')!;
  date.min = new Date().toISOString().slice(0, 10);

  form.addEventListener('change', () => {
    if (form.querySelector('input[name="treatment"]:checked')) error.classList.add('hidden');
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const treatments = data.getAll('treatment') as string[];
    if (!treatments.length) {
      error.classList.remove('hidden');
      form.querySelector<HTMLInputElement>('input[name="treatment"]')!.focus();
      return;
    }
    const name = String(data.get('name') || '').trim();
    const d = String(data.get('date') || '');
    const when = d
      ? new Date(`${d}T12:00:00`).toLocaleDateString('en-ZA', {weekday: 'long', day: 'numeric', month: 'long'})
      : 'any day that suits';
    const lines = [
      `Hi Kirby and Teen!${name ? ` This is ${name}.` : ''} I would like to book:`,
      ...treatments.map((t) => `• ${t}`),
      `Preferred day: ${when}`,
      `Time: ${data.get('time') || 'any time'}`,
      `For: ${data.get('people')}`,
    ];
    const notes = String(data.get('notes') || '').trim();
    if (notes) lines.push(`Notes: ${notes}`);
    window.open(`https://wa.me/${site.whatsapp}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
  });
</script>
