---
import {absUrl} from '../../lib/url';
import {Image} from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import {photo, facePosition, teamPhoto} from '../../lib/photos';
import {faqSchema} from '../../lib/schema';
import {services, type ServiceCategory} from '../../data/services';
import {member} from '../../data/team';
import {site, whatsappLink} from '../../data/site';

export function getStaticPaths() {
  return services.map((s) => ({params: {slug: s.slug}, props: {s}}));
}

const {s} = Astro.props as {s: ServiceCategory};
const crumbs = [
  {name: 'Services', href: '/services/'},
  {name: s.name, href: `/services/${s.slug}/`},
];
const gallery = s.photos.map(photo);
const people = s.team.map(member).filter((m) => !!m);
const others = services.filter((x) => x.slug !== s.slug);
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.name,
  serviceType: s.name,
  description: s.seoDescription,
  areaServed: {'@type': 'City', name: 'Cape Town'},
  provider: {'@id': absUrl('/#business', Astro.site)},
  url: absUrl(`/services/${s.slug}/`, Astro.site),
};
---

<Base title={s.seoTitle} description={s.seoDescription} crumbs={crumbs} schema={[serviceSchema, faqSchema(s.faqs)]}>
  <PageHero eyebrow={`${s.name} · Table View, Cape Town`} lines={s.lines} intro={s.short} image={s.hero} crumbs={crumbs} />

  <!-- Introduction -->
  <section class="bg-paper py-24 md:py-32" aria-labelledby="about-title">
    <div class="mx-auto grid max-w-[1680px] gap-12 px-5 md:grid-cols-12 md:px-14">
      <h2 id="about-title" class="display text-[clamp(40px,4.6vw,80px)] md:col-span-5" data-reveal>
        {s.label} at<br /><span class="it">Kirby and Teen</span>
      </h2>
      <div class="prose-kt text-[18px] text-muted md:col-span-6 md:col-start-7" data-reveal style="--d:.1s">
        {s.intro.map((t) => <p>{t}</p>)}
      </div>
    </div>
  </section>

  <!-- Treatment menu -->
  <section class="bg-ink py-24 text-paper md:py-32" aria-labelledby="menu-title">
    <div class="mx-auto max-w-[1680px] px-5 md:px-14">
      <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
        <h2 id="menu-title" class="display text-[clamp(44px,5.4vw,96px)]">The <span class="it">treatments</span></h2>
        <p class="max-w-md text-paper/75">Prices depend on length, design and add-ons, so we quote on WhatsApp before you book — no surprises.</p>
      </div>
      <div class="mt-16 grid gap-16 md:grid-cols-2 md:gap-x-20">
        {
          s.groups.map((g) => (
            <div data-reveal>
              <h3 class="caps border-b border-paper/20 pb-4 text-brass">{g.title}</h3>
              <ul>
                {g.items.map((t) => (
                  <li class="border-b border-paper/10 py-6">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                      <h4 class="display text-[clamp(26px,2.2vw,36px)]">{t.name}</h4>
                      {t.duration && <span class="caps text-paper/60">{t.duration}</span>}
                    </div>
                    <p class="mt-2 max-w-[58ch] text-paper/75">{t.desc}</p>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="mt-14" data-reveal>
        <a href={whatsappLink(`Hi Kirby and Teen! I would like to book: ${s.name}.`)} class="btn btn-paper" target="_blank" rel="noopener">Ask for a quote &amp; book</a>
      </div>
    </div>
  </section>

  <!-- Why us -->
  <section class="bg-sand py-24 md:py-32" aria-labelledby="why-title">
    <div class="mx-auto max-w-[1680px] px-5 md:px-14">
      <h2 id="why-title" class="display text-[clamp(40px,4.6vw,80px)]" data-reveal>Why clients <span class="it">choose us</span></h2>
      <ul class="mt-14 grid gap-10 md:grid-cols-3">
        {
          s.why.map((w, i) => (
            <li class="border-t border-ink/20 pt-6" data-reveal style={`--d:${i * 0.08}s`}>
              <span class="caps text-muted">0{i + 1}</span>
              <h3 class="display mt-3 text-[32px]">{w.title}</h3>
              <p class="mt-3 text-muted">{w.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Photos -->
  {
    gallery.length > 1 && (
      <section class="bg-paper pt-24 md:pt-32" aria-labelledby="photos-title">
        <div class="mx-auto flex max-w-[1680px] flex-wrap items-end justify-between gap-6 px-5 md:px-14" data-reveal>
          <h2 id="photos-title" class="display text-[clamp(40px,4.6vw,80px)]">
            Recent <span class="it">work</span>
          </h2>
          <a href="/gallery/" class="btn btn-line text-ink">Full gallery</a>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-[3px] px-[3px] md:grid-cols-4">
          {gallery.map((p, i) => (
            <li class="overflow-hidden" data-reveal style={`--d:${(i % 4) * 0.07}s`}>
              <Image src={p.src} alt={p.alt} widths={[400, 700]} sizes="(min-width: 768px) 25vw, 50vw" class="aspect-[4/5] w-full object-cover" />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Team -->
  {
    people.length > 0 && (
      <section class="bg-paper py-24 md:py-32" aria-labelledby="who-title">
        <div class="mx-auto max-w-[1680px] px-5 md:px-14">
          <h2 id="who-title" class="display text-[clamp(40px,4.6vw,80px)]" data-reveal>
            Who will <span class="it">look after you</span>
          </h2>
          <ul class="mt-12 grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-4">
            {people.map((m, i) => (
              <li data-reveal style={`--d:${(i % 4) * 0.07}s`}>
                <Image src={teamPhoto(m!.photo)} alt={`${m!.name}, ${m!.role.toLowerCase()} at Kirby and Teen`} widths={[300, 600]} sizes="(min-width: 768px) 22vw, 48vw" class="aspect-[4/5] w-full object-cover" style={`object-position:${facePosition(teamPhoto(m!.photo), m!.face)}`} />
                <h3 class="display mt-4 text-[28px]">{m!.name}</h3>
                <p class="caps text-muted">{m!.role}</p>
                <p class="mt-2 text-[15px] leading-relaxed text-muted">{m!.bio}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <Faq faqs={s.faqs} title={`${s.label}: your questions`} />

  <!-- Other services -->
  <section class="bg-ink py-20 text-paper" aria-labelledby="more-title">
    <div class="mx-auto max-w-[1680px] px-5 md:px-14">
      <h2 id="more-title" class="caps text-paper/60">More at Kirby and Teen</h2>
      <ul class="mt-6 grid gap-px bg-paper/15 md:grid-cols-3">
        {
          others.map((o) => (
            <li class="bg-ink">
              <a href={`/services/${o.slug}/`} class="group block py-8 md:px-8">
                <span class="display block text-[clamp(30px,2.8vw,46px)] group-hover:text-blush">{o.name}</span>
                <span class="mt-2 block text-paper/70">{o.short}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand message={`Hi Kirby and Teen! I would like to book: ${s.name}.`} text={`Tell us which ${s.name.toLowerCase()} treatment you would like and a day that suits you, and we will reply on WhatsApp with open times. Or call ${site.phoneDisplay}.`} />
</Base>
