---
import {Image} from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import {photo} from '../../lib/photos';
import {faqSchema} from '../../lib/schema';
import {services} from '../../data/services';

const crumbs = [{name: 'Services', href: '/services/'}];
const faqs = [
  {q: 'Can I combine treatments in one visit?', a: 'Absolutely. Many clients book gel hands with a pedicure, or lashes with a new nail set. Tell us everything you would like on WhatsApp and we will line up the right people so your visit flows.'},
  {q: 'Why are there no prices on the website?', a: 'Nail prices depend on length, shape, overlay type and nail art, so a fixed list rarely tells the full story. Send us a message and we will give you an honest quote before you book.'},
  {q: 'Do you take walk-ins?', a: 'We work mostly by appointment so that nobody is rushed. If you are nearby, send a WhatsApp — if a technician is free we will happily fit you in.'},
  {q: 'Which areas do your clients come from?', a: 'Most of our clients live or work in Table View, Blouberg, Parklands, Sunningdale, West Beach, Big Bay, Milnerton and Melkbosstrand.'},
];
---

<Base
  title="Services: Nails, Pedicures, Lashes, Brows, Waxing & Massage"
  description="Gel and acrylic nails, nail art, gel pedicures, lash extensions, brow lamination, waxing and eight massage treatments at Kirby and Teen, Table View."
  crumbs={crumbs}
  schema={[faqSchema(faqs)]}
>
  <PageHero
    eyebrow="The Kirby and Teen menu"
    lines={[{t: 'Everything'}, {t: 'under one roof.', i: true}]}
    intro="Nails, pedicures, lashes, brows, waxing and massage — by a team of fifteen specialists in a calm boutique on Blaauwberg Road."
    image="kirby-and-teen-salon-pedicure-lounge-table-view"
    crumbs={crumbs}
  />

  <section class="bg-paper py-24 md:py-32" aria-labelledby="intro-title">
    <div class="mx-auto grid max-w-[1680px] gap-12 px-5 md:grid-cols-12 md:px-14">
      <h2 id="intro-title" class="display text-[clamp(40px,4.6vw,80px)] md:col-span-5" data-reveal>Choose your <span class="it">treatment</span></h2>
      <div class="prose-kt text-[18px] text-muted md:col-span-6 md:col-start-7" data-reveal style="--d:.1s">
        <p>
          Kirby and Teen started as a nail boutique in 2014 and has grown into a full beauty boutique in Table View. Today our nail technicians, pedi tech, lash and brow specialists and beauty therapist work side by side, so you can have your nails, toes, lashes and brows done — or slip away for a massage — in a single visit.
        </p>
        <p>Pick a category below to see every treatment we offer, how it works and who will look after you.</p>
      </div>
    </div>
  </section>

  <section class="bg-paper pb-24 md:pb-32" aria-label="Service categories">
    <ul class="mx-auto grid max-w-[1680px] gap-[3px] px-[3px] md:grid-cols-2">
      {
        services.map((s, i) => {
          const p = photo(s.hero);
          return (
            <li data-reveal style={`--d:${(i % 2) * 0.1}s`}>
              <a href={`/services/${s.slug}/`} class="group relative block aspect-[4/5] overflow-hidden bg-ink text-paper md:aspect-[5/4]">
                <Image src={p.src} alt={p.alt} widths={[640, 1000, 1400]} sizes="(min-width: 768px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1600ms] ease-silk group-hover:scale-105" />
                <div class="absolute inset-0 bg-[linear-gradient(0deg,rgb(26_21_18/0.85),rgb(26_21_18/0.1)_60%)]" />
                <div class="absolute inset-x-0 bottom-0 p-7 md:p-10">
                  <span class="caps text-paper/70">0{i + 1}</span>
                  <h3 class="display mt-2 text-[clamp(40px,4vw,72px)]">{s.name}</h3>
                  <p class="mt-3 max-w-[44ch] text-paper/85">{s.short}</p>
                  <ul class="mt-5 flex flex-wrap gap-2">
                    {s.groups.flatMap((g) => g.items).slice(0, 4).map((t) => (
                      <li class="caps border border-paper/35 px-3 py-1">{t.name}</li>
                    ))}
                  </ul>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <!-- Every treatment at a glance (good for visitors and for search) -->
  <section class="bg-ink py-24 text-paper md:py-32" aria-labelledby="all-title">
    <div class="mx-auto max-w-[1680px] px-5 md:px-14">
      <h2 id="all-title" class="display text-[clamp(44px,5.4vw,96px)]" data-reveal>At a <span class="it">glance</span></h2>
      <div class="mt-14 grid gap-12 md:grid-cols-4">
        {
          services.map((s, i) => (
            <div data-reveal style={`--d:${i * 0.07}s`}>
              <h3 class="caps border-b border-paper/20 pb-3 text-brass">
                <a href={`/services/${s.slug}/`} class="hover:text-paper">{s.name}</a>
              </h3>
              <ul class="mt-4 space-y-2 text-paper/80">
                {s.groups.flatMap((g) => g.items).map((t) => (
                  <li>
                    {t.name}
                    {t.duration && <span class="text-paper/50"> · {t.duration}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Faq faqs={faqs} />
  <CtaBand />
</Base>
