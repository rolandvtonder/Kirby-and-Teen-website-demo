---
import {absUrl} from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import {faqSchema} from '../lib/schema';
import {fullAddress, hours, site, whatsappLink} from '../data/site';

const crumbs = [{name: 'Contact', href: '/contact/'}];
const faqs = [
  {q: 'Where exactly are you?', a: `${fullAddress}. We are on Blaauwberg Road in Table View, close to Blouberg, Parklands and Sunningdale. Tap "Get directions" for turn-by-turn navigation.`},
  {q: 'What is the best way to reach you?', a: `WhatsApp is quickest: ${site.phoneDisplay}. You can also call the same number or email ${site.email}.`},
  {q: 'Do you take walk-ins?', a: 'We work mostly by appointment, but send us a WhatsApp — if a technician is free, we will fit you in.'},
  {q: 'Do you offer anything for groups?', a: 'Yes. With four side-by-side pedicure recliners and a large team, we can look after friends, sisters and mom-and-daughter groups together. Message us with numbers and the treatments you would like.'},
];
const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Kirby and Teen',
  url: absUrl('/contact/', Astro.site),
  about: {'@id': absUrl('/#business', Astro.site)},
};
const ways = [
  {k: 'WhatsApp', v: site.phoneDisplay, href: whatsappLink(), ext: true, note: 'Fastest replies — bookings and questions'},
  {k: 'Call', v: site.phoneDisplay, href: `tel:${site.phoneIntl}`, ext: false, note: 'During opening hours'},
  {k: 'Email', v: site.email, href: `mailto:${site.email}`, ext: false, note: 'For longer questions'},
  {k: 'Instagram', v: '@kirbyandteen', href: site.instagram, ext: true, note: 'New sets every week'},
  {k: 'Facebook', v: 'Kirby and Teen', href: site.facebook, ext: true, note: 'Specials, news and reviews'},
];
---

<Base
  title="Contact & Directions: Blaauwberg Road, Table View"
  description={`Find Kirby and Teen at ${fullAddress}. WhatsApp or call ${site.phoneDisplay}, email ${site.email}, opening hours and directions.`}
  crumbs={crumbs}
  schema={[contactSchema, faqSchema(faqs)]}
>
  <PageHero
    eyebrow="Contact · Visit us"
    lines={[{t: 'Find us on'}, {t: 'Blaauwberg Road.', i: true}]}
    intro={`${fullAddress}. Message us on WhatsApp, give us a call or just pop in to say hello.`}
    image="kirby-and-teen-salon-pedicure-lounge-table-view"
    pos="70% center"
    crumbs={crumbs}
  />

  <section class="bg-paper py-24 md:py-32" aria-labelledby="ways-title">
    <div class="mx-auto grid max-w-[1680px] gap-14 px-5 md:grid-cols-12 md:px-14">
      <div class="md:col-span-5" data-reveal>
        <h2 id="ways-title" class="display text-[clamp(44px,5.4vw,96px)]">Get in <span class="it">touch</span></h2>
        <address class="mt-8 text-[18px] not-italic">
          <span class="caps block text-muted">Address</span>
          {site.legalName}<br />
          {site.address.street}<br />
          {site.address.suburb}, {site.address.city}<br />
          {site.address.region}, {site.address.postcode}<br />
          South Africa
        </address>
        <a href={site.mapsUrl} class="btn btn-ink mt-8" target="_blank" rel="noopener">Get directions</a>

        <h3 class="caps mt-12 text-muted">Opening hours</h3>
        <dl class="mt-3 max-w-sm space-y-2 text-[18px]">
          {hours.map((h) => <div class="flex justify-between gap-6 border-b border-ink/10 pb-2"><dt class="text-muted">{h.days}</dt><dd>{h.time}</dd></div>)}
        </dl>
        <p class="mt-4 text-[15px] text-muted">Hours may change over public holidays — check our Facebook page or send us a message.</p>
      </div>

      <ul class="self-start border-t border-ink/15 md:col-span-6 md:col-start-7" data-reveal style="--d:.1s">
        {
          ways.map((w) => (
            <li class="border-b border-ink/15">
              <a href={w.href} class="group grid gap-1 py-6 md:grid-cols-[140px_1fr_auto] md:items-center md:gap-6" target={w.ext ? '_blank' : undefined} rel={w.ext ? 'noopener' : undefined}>
                <span class="caps text-muted">{w.k}</span>
                <span>
                  <span class="display block break-all text-[clamp(26px,2.4vw,40px)] normal-case group-hover:text-cocoa">{w.v}</span>
                  <span class="text-[15px] text-muted">{w.note}</span>
                </span>
                <span aria-hidden="true" class="hidden text-2xl transition-transform group-hover:translate-x-1 md:block">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-sand" aria-label="Map">
    <iframe
      title="Map showing Kirby and Teen at 123 Blaauwberg Road, Table View, Cape Town"
      src={site.mapsEmbed}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="block h-[70svh] min-h-[420px] w-full border-0 grayscale-[0.6] sepia-[0.2]"></iframe>
  </section>

  <section class="bg-paper py-24 md:py-32" aria-labelledby="area-title">
    <div class="mx-auto grid max-w-[1680px] gap-12 px-5 md:grid-cols-12 md:px-14">
      <h2 id="area-title" class="display text-[clamp(40px,4.6vw,80px)] md:col-span-5" data-reveal>Your local <span class="it">boutique</span></h2>
      <div class="md:col-span-6 md:col-start-7" data-reveal style="--d:.1s">
        <p class="text-[18px] text-muted">
          Kirby and Teen sits on Blaauwberg Road in the heart of Table View, making us an easy stop for clients from across the Blaauwberg coast and northern suburbs, including:
        </p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {site.nearby.map((n) => <li class="caps border border-ink/20 px-3 py-2">{n}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <Faq faqs={faqs} />
  <CtaBand />
</Base>
