---
import {Image} from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import {photo} from '../lib/photos';
import {faqSchema} from '../lib/schema';
import {site, whatsappLink} from '../data/site';

const crumbs = [{name: 'Specials', href: '/specials/'}];
const poster = photo('nail-art-yes-please-special');
const perfect = photo('the-perfect-day');

/**
 * TODO: keep the current special up to date. Change the text below (or set
 * `current` to null to hide the block) when the offer ends.
 */
const current: {title: [string, string]; price: string; text: string; terms: string} | null = {
  title: ['Nail art?', 'Yes, please.'],
  price: 'R400',
  text: 'Book a new set and your nail art is on us — polka dots, tortoiseshell, chrome, plaid, bows or florals. Choose your shape, choose your design, and pay R400 for the lot.',
  terms: 'New sets only. T&Cs apply — ask us on WhatsApp for details.',
};

// Pamper packages the boutique runs for occasions like Women's Month.
const packages = [
  {name: 'The Queen Treatment', for: 'For anyone needing a full pamper reset', items: ['60-minute relaxing massage', 'Luxury gel pedicure', 'A glass of bubbles']},
  {name: 'Soul Sister Day', for: 'For sisters, besties and mom & daughter duos', items: ['Gel hands and mini gel pedicure for two', 'Hand massage', 'A glass of bubbles']},
  {name: 'Polished & Powerful', for: 'For when you want to feel glam', items: ['Rubber base overlay', 'French paint or nail art']},
  {name: 'Glow From Within', for: 'Perfect for anyone in burnout mode', items: ['Relaxing reflexology gel or polish pedicure', 'Epsom-salt foot soak and hydrating cream', 'Calming tea']},
];

const perfectDay = ['A fresh new set', 'Brow lamination', 'A luxe pedicure', 'A relaxing massage', 'Bubbles', 'Coffee', 'Lashes'];

const faqs = [
  {q: 'How do I claim a special?', a: `Mention the special when you book on WhatsApp (${site.phoneDisplay}) so we can apply it and set aside the right amount of time.`},
  {q: 'Can I combine specials?', a: 'Specials usually cannot be combined with each other, but ask us — we are always happy to help you get the best value.'},
  {q: 'How do I hear about new specials first?', a: 'Follow us on Instagram and Facebook. We post new specials, seasonal nail art and pamper packages there first.'},
  {q: 'Can I book a package as a gift?', a: 'Message us on WhatsApp and tell us who it is for — we will help you arrange it.'},
];
---

<Base
  title="Specials & Pamper Packages"
  description="Current nail specials and pamper packages at Kirby and Teen, Table View: a new set with free nail art, plus massage and pedicure treat days."
  crumbs={crumbs}
  schema={[faqSchema(faqs)]}
>
  <PageHero
    eyebrow="Specials · Packages"
    lines={[{t: 'Spoil yourself,'}, {t: 'you deserve it.', i: true}]}
    intro="Monthly specials, seasonal nail art and pamper packages for a full day of being looked after — on your own or with your favourite people."
    image="pearl-french-tip-nails"
    crumbs={crumbs}
  />

  {
    current && (
      <section class="bg-sand py-24 md:py-32" aria-labelledby="current-title">
        <div class="mx-auto grid max-w-[1680px] items-center gap-12 px-5 md:grid-cols-12 md:px-14">
          <div class="md:col-span-5" data-reveal>
            <Image src={poster.src} alt={poster.alt} widths={[500, 900]} sizes="(min-width: 768px) 40vw, 100vw" class="w-full shadow-[0_30px_80px_rgb(26_21_18/0.25)]" />
          </div>
          <div class="md:col-span-6 md:col-start-7" data-reveal style="--d:.1s">
            <p class="caps text-muted">Current special</p>
            <h2 id="current-title" class="display mt-4 text-[clamp(48px,6vw,110px)]">
              {current.title[0]}
              <br />
              <span class="it">{current.title[1]}</span>
            </h2>
            <p class="mt-6 flex items-baseline gap-4">
              <span class="caps text-muted">New set + free nail art</span>
              <span class="display text-[clamp(48px,5vw,80px)] text-cocoa">{current.price}</span>
            </p>
            <p class="mt-4 max-w-[50ch] text-[18px] text-muted">{current.text}</p>
            <p class="mt-3 text-[15px] text-muted">{current.terms}</p>
            <a href={whatsappLink('Hi Kirby and Teen! I would like to book the new set + free nail art special.')} class="btn btn-ink mt-8" target="_blank" rel="noopener">
              Claim the special
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- Packages -->
  <section class="bg-ink py-24 text-paper md:py-32" aria-labelledby="packages-title">
    <div class="mx-auto max-w-[1680px] px-5 md:px-14">
      <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
        <h2 id="packages-title" class="display text-[clamp(44px,5.4vw,96px)]">Pamper <span class="it">packages</span></h2>
        <p class="max-w-md text-paper/75">Our favourite combinations, brought back for occasions like Women's Month. Ask on WhatsApp which packages are running and what they cost right now.</p>
      </div>
      <ul class="mt-14 grid gap-[3px] md:grid-cols-2">
        {
          packages.map((p, i) => (
            <li class="bg-paper/[0.04] p-8 ring-1 ring-paper/10 md:p-12" data-reveal style={`--d:${(i % 2) * 0.08}s`}>
              <span class="caps text-brass">Package 0{i + 1}</span>
              <h3 class="display mt-3 text-[clamp(34px,3.2vw,54px)]">{p.name}</h3>
              <p class="mt-2 text-paper/70">{p.for}</p>
              <ul class="mt-6 space-y-2">
                {p.items.map((it) => (
                  <li class="flex gap-3">
                    <span aria-hidden="true" class="mt-[0.7em] h-px w-5 shrink-0 bg-brass" />
                    {it}
                  </li>
                ))}
              </ul>
              <a href={whatsappLink(`Hi Kirby and Teen! Is the ${p.name} package available?`)} class="caps mt-8 inline-flex items-center gap-3 border-b border-paper/50 pb-1 hover:border-paper" target="_blank" rel="noopener">
                Ask about this package <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- The perfect day -->
  <section class="bg-paper py-24 md:py-32" aria-labelledby="day-title">
    <div class="mx-auto grid max-w-[1680px] items-center gap-12 px-5 md:grid-cols-12 md:px-14">
      <div class="md:col-span-6" data-reveal>
        <p class="caps text-muted">Build your own</p>
        <h2 id="day-title" class="display mt-4 text-[clamp(44px,5.4vw,96px)]">The perfect day<br /><span class="it">does exist.</span></h2>
        <p class="mt-6 max-w-[48ch] text-[18px] text-muted">
          Take the day off and let us do everything. Tell us what you want and we will plan the order of your treatments so you move from one chair to the next without waiting.
        </p>
        <ol class="mt-8 grid grid-cols-2 gap-x-8 gap-y-3">
          {
            perfectDay.map((d, i) => (
              <li class="flex items-baseline gap-3 border-b border-ink/15 pb-3">
                <span class="caps text-muted">0{i + 1}</span>
                {d}
              </li>
            ))
          }
        </ol>
        <a href={whatsappLink('Hi Kirby and Teen! I would like to plan a full pamper day.')} class="btn btn-ink mt-10" target="_blank" rel="noopener">Plan my day</a>
      </div>
      <div class="md:col-span-5 md:col-start-8" data-reveal style="--d:.1s">
        <Image src={perfect.src} alt={perfect.alt} widths={[500, 900]} sizes="(min-width: 768px) 40vw, 100vw" class="w-full" />
      </div>
    </div>
  </section>

  <!-- Follow -->
  <section class="bg-cocoa py-20 text-paper" aria-labelledby="follow-title">
    <div class="mx-auto flex max-w-[1680px] flex-wrap items-center justify-between gap-8 px-5 md:px-14" data-reveal>
      <h2 id="follow-title" class="display text-[clamp(36px,4vw,68px)]">New specials, <span class="it">every month</span></h2>
      <div class="flex flex-wrap gap-3">
        <a href={site.instagram} class="btn btn-paper" target="_blank" rel="noopener">Follow on Instagram</a>
        <a href={site.facebook} class="btn btn-line text-paper hover:!bg-paper hover:!text-ink" target="_blank" rel="noopener">Follow on Facebook</a>
      </div>
    </div>
  </section>

  <Faq faqs={faqs} />
  <CtaBand />
</Base>
