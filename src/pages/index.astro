---
import {Image} from 'astro:assets';
import Base from '../layouts/Base.astro';
import HomeHero from '../components/HomeHero.astro';
import Panels from '../components/Panels.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import {photo, teamPhoto} from '../lib/photos';
import {faqSchema} from '../lib/schema';
import {fullAddress, hours, site, whatsappLink, yearsOpen} from '../data/site';
import {services} from '../data/services';
import {owners, team} from '../data/team';

const faqs = [
  {q: 'Where is Kirby and Teen?', a: `We are at ${fullAddress}, on Blaauwberg Road in Table View — an easy drive from Blouberg, Parklands, Sunningdale and Milnerton.`},
  {q: 'How do I book an appointment?', a: `The quickest way is WhatsApp on ${site.phoneDisplay}. Tell us the treatment you would like and a day that suits you, and we will confirm a time. You are also welcome to call.`},
  {q: 'What treatments do you offer?', a: 'Gel overlays, rubber base, acrylic sets, nail art, manicures, gel and spa pedicures, lash extensions, brow lamination and shaping, waxing, and a full massage menu including Swedish, deep tissue, hot stone, aromatherapy and reflexology.'},
  {q: 'How much do your treatments cost?', a: 'Prices depend on the treatment, length and nail art you choose, so we quote on WhatsApp before you book. Look out for our monthly specials on the Specials page.'},
  {q: 'Can I book with a friend?', a: 'Yes — our pedicure recliners sit side by side and we can line up several technicians at once, so friends, sisters and mom-and-daughter duos can be pampered together.'},
];

const strip = ['white-french-stiletto-nails', 'plaid-burgundy-nail-art', 'gold-chrome-nail-art', 'red-nails-ribbon-nail-art', 'brow-lamination-result', 'pink-star-glitter-nail-art', 'tortoiseshell-french-tips', 'teal-almond-gel-nails'].map(photo);
const special = photo('nail-art-yes-please-special');
const people = team.slice(0, 4);
---

<Base
  title="Kirby and Teen | Nail Salon & Massage in Table View, Cape Town"
  description={`Nail, lash, brow & massage boutique on Blaauwberg Road, Table View. Gel and acrylic nails, nail art, pedicures, lashes and massage since ${site.established}.`}
  schema={[faqSchema(faqs)]}
>
  <HomeHero
    eyebrow="Nail · Lash · Brow · Massage boutique — Table View, Cape Town"
    lines={[{t: 'Polished with'}, {t: 'Care.', i: true}, {t: 'Pampered in'}, {t: 'Table View', i: true}]}
    body={`For ${yearsOpen} years we have done superior nails, lashes and brows with creativity, quality and attention to detail. Every visit is personal — you leave refreshed and feeling beautiful.`}
    slides={['kirby-and-teen-salon-pedicure-lounge-table-view', 'oxblood-gel-nails', 'candlelit-massage-room', 'white-french-stiletto-nails']}
  />

  <Panels
    image="kirby-and-teen-salon-pedicure-lounge-table-view"
    label="Our treatments"
    panels={[
      {name: ['Nails &', 'Manicures'], specs: [['Gel & rubber base', 'Overlays that last'], ['Acrylic sets', 'Almond · coffin · square'], ['Nail art', 'Hand-painted']], href: '/services/nails/', tint: '#5b3a2b'},
      {name: ['Lashes, brows', '& Waxing'], specs: [['Lashes', 'Extensions & refills'], ['Brows', 'Lamination · shape · tint']], href: '/services/lashes-brows-waxing/', tint: '#1a1512'},
      {name: ['Pedicures', '& Massage'], specs: [['Pedicures', 'Luxury gel in recliners'], ['Massage', 'Eight treatments, 30–90 min']], href: '/services/massage/', tint: '#9c8579'},
    ]}
  />

  <!-- Introduction -->
  <section class="bg-paper py-24 md:py-36" aria-labelledby="intro-title">
    <div class="mx-auto grid max-w-[1680px] gap-14 px-5 md:grid-cols-12 md:px-14">
      <div class="md:col-span-6" data-reveal>
        <p class="caps text-muted">Est. {site.established} · {site.address.street}</p>
        <h2 id="intro-title" class="display mt-5 text-[clamp(44px,5.4vw,96px)]">
          A boutique,<br /><span class="it">not a</span><br />production line.
        </h2>
      </div>
      <div class="prose-kt self-end text-[18px] text-muted md:col-span-5 md:col-start-8" data-reveal style="--d:.1s">
        <p>
          Kirby and Teen is a nail, lash, brow and massage boutique in Table View, Cape Town, run by sisters Kirby and Christine. For {yearsOpen} years we have built our name on one thing: clients who leave feeling pampered, confident and cared for.
        </p>
        <p>
          Sink into a recliner beneath our chocolate arch for a gel pedicure, sit down with one of our nail artists for a new set, or slip behind the wooden door for a candlelit massage. Every appointment is unhurried and personal — and yes, there is coffee and bubbly.
        </p>
        <a href="/about/" class="btn btn-line mt-8 text-ink">Meet the team</a>
      </div>
    </div>

    <dl class="mx-auto mt-24 grid max-w-[1680px] grid-cols-2 gap-px bg-ink/10 px-5 md:grid-cols-4 md:px-14">
      {
        [
          [String(site.established), 'Year we opened'],
          [`${site.recommend.percent}%`, `Recommend us (${site.recommend.count} reviews)`],
          [String(team.length + 2), 'Artists, therapists & hosts'],
          ['4', 'Pedicure recliners'],
        ].map(([v, k], i) => (
          <div class="flex flex-col-reverse bg-paper px-2 py-8 md:px-6" data-reveal style={`--d:${i * 0.08}s`}>
            <dt class="caps mt-3 text-muted">{k}</dt>
            <dd class="display text-[clamp(44px,4.6vw,80px)]">{v}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Services overview -->
  <section class="bg-ink py-24 text-paper md:py-36" aria-labelledby="services-title">
    <div class="mx-auto max-w-[1680px] px-5 md:px-14">
      <div class="flex flex-wrap items-end justify-between gap-8" data-reveal>
        <h2 id="services-title" class="display text-[clamp(44px,5.4vw,96px)]">The <span class="it">menu</span></h2>
        <p class="max-w-md text-paper/75">Four rooms of treatments under one roof. Book one, or combine a few for a full pamper visit.</p>
      </div>
      <ul class="mt-16 border-t border-paper/15">
        {
          services.map((s, i) => (
            <li class="border-b border-paper/15" data-reveal style={`--d:${i * 0.06}s`}>
              <a href={`/services/${s.slug}/`} class="group grid items-center gap-4 py-8 md:grid-cols-12 md:py-10">
                <span class="caps text-paper/50 md:col-span-1">0{i + 1}</span>
                <h3 class="display text-[clamp(34px,3.6vw,64px)] transition-colors group-hover:text-blush md:col-span-5">{s.name}</h3>
                <p class="text-paper/75 md:col-span-5">{s.short}</p>
                <span aria-hidden="true" class="text-2xl transition-transform duration-500 group-hover:translate-x-2 md:col-span-1 md:justify-self-end">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Recent work -->
  <section class="overflow-hidden bg-paper py-24 md:py-36" aria-labelledby="work-title">
    <div class="mx-auto flex max-w-[1680px] flex-wrap items-end justify-between gap-6 px-5 md:px-14" data-reveal>
      <div>
        <p class="caps text-muted">Fresh from the boutique</p>
        <h2 id="work-title" class="display mt-4 text-[clamp(44px,5.4vw,96px)]">Recent <span class="it">sets</span></h2>
      </div>
      <a href="/gallery/" class="btn btn-line text-ink">See the full gallery</a>
    </div>
    <ul class="mt-14 grid grid-cols-2 gap-[3px] px-[3px] md:grid-cols-4">
      {
        strip.map((p, i) => (
          <li class="overflow-hidden" data-reveal style={`--d:${(i % 4) * 0.07}s`}>
            <Image src={p.src} alt={p.alt} widths={[400, 700]} sizes="(min-width: 768px) 25vw, 50vw" class="aspect-[4/5] w-full object-cover transition-transform duration-[1400ms] ease-silk hover:scale-105" />
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Special -->
  <section class="bg-sand py-24 md:py-32" aria-labelledby="special-title">
    <div class="mx-auto grid max-w-[1680px] items-center gap-12 px-5 md:grid-cols-12 md:px-14">
      <div class="md:col-span-5" data-reveal>
        <Image src={special.src} alt={special.alt} widths={[500, 900]} sizes="(min-width: 768px) 40vw, 100vw" class="w-full shadow-[0_30px_80px_rgb(26_21_18/0.25)]" />
      </div>
      <div class="md:col-span-6 md:col-start-7" data-reveal style="--d:.1s">
        <p class="caps text-muted">Current special</p>
        <h2 id="special-title" class="display mt-4 text-[clamp(44px,5.4vw,96px)]">Nail art?<br /><span class="it">Yes, please.</span></h2>
        <p class="mt-6 max-w-[48ch] text-[18px] text-muted">
          Book a new set and get your nail art free — the whole thing for <strong class="font-medium text-ink">R400</strong>. Polka dots, tortoiseshell, chrome, plaid, bows: choose your design. T&amp;Cs apply.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={whatsappLink('Hi Kirby and Teen! I would like to book the new set + free nail art special.')} class="btn btn-ink" target="_blank" rel="noopener">Claim the special</a>
          <a href="/specials/" class="btn btn-line text-ink">All specials &amp; packages</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="bg-paper py-24 md:py-36" aria-labelledby="team-title">
    <div class="mx-auto max-w-[1680px] px-5 md:px-14">
      <div class="grid gap-10 md:grid-cols-12">
        <div class="md:col-span-5" data-reveal>
          <p class="caps text-muted">The people</p>
          <h2 id="team-title" class="display mt-4 text-[clamp(44px,5.4vw,96px)]">Sisters,<br /><span class="it">and a team</span><br />of artists</h2>
          <p class="mt-6 max-w-[46ch] text-[18px] text-muted">{owners.bio}</p>
          <a href="/about/" class="btn btn-line mt-8 text-ink">Our story</a>
        </div>
        <div class="md:col-span-6 md:col-start-7" data-reveal style="--d:.1s">
          <Image src={teamPhoto(owners.photo)} alt="Sisters Kirby and Christine, owners of Kirby and Teen, sitting back to back and smiling" widths={[600, 1000]} sizes="(min-width: 768px) 45vw, 100vw" class="aspect-[16/10] w-full object-cover" />
        </div>
      </div>
      <ul class="mt-16 grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-4">
        {
          people.map((m, i) => (
            <li data-reveal style={`--d:${i * 0.07}s`}>
              <Image src={teamPhoto(m.photo)} alt={`${m.name}, ${m.role.toLowerCase()} at Kirby and Teen`} widths={[300, 600]} sizes="(min-width: 768px) 22vw, 48vw" class="aspect-[4/5] w-full object-cover" style={`object-position:${m.pos ?? '50% 30%'}`} />
              <p class="display mt-4 text-[28px]">{m.name}</p>
              <p class="caps text-muted">{m.role}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Reviews teaser -->
  <section class="bg-ink py-24 text-paper md:py-32" aria-labelledby="reviews-title">
    <div class="mx-auto max-w-[1200px] px-5 text-center md:px-14" data-reveal>
      <p class="caps text-paper/60">What clients say</p>
      <h2 id="reviews-title" class="display mt-5 text-[clamp(70px,12vw,220px)] leading-[0.85]">{site.recommend.percent}<span class="it">%</span></h2>
      <p class="mx-auto mt-6 max-w-[40ch] text-[20px] text-paper/85">of {site.recommend.count} clients who reviewed us on Facebook recommend Kirby and Teen.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href="/reviews/" class="btn btn-paper">Read about our reviews</a>
        <a href={site.facebookReviews} class="btn btn-line text-paper hover:!bg-paper hover:!text-ink" target="_blank" rel="noopener">Reviews on Facebook</a>
      </div>
    </div>
  </section>

  <!-- Visit -->
  <section class="bg-paper py-24 md:py-32" aria-labelledby="visit-title">
    <div class="mx-auto grid max-w-[1680px] gap-12 px-5 md:grid-cols-12 md:px-14">
      <div class="md:col-span-5" data-reveal>
        <p class="caps text-muted">Visit us</p>
        <h2 id="visit-title" class="display mt-4 text-[clamp(44px,5.4vw,96px)]">On Blaauwberg<br /><span class="it">Road</span></h2>
        <address class="mt-6 text-[18px] not-italic text-muted">{fullAddress}</address>
        <dl class="mt-6 max-w-sm space-y-1 text-muted">
          {hours.map((h) => <div class="flex justify-between gap-6"><dt>{h.days}</dt><dd class="text-ink">{h.time}</dd></div>)}
        </dl>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={site.mapsUrl} class="btn btn-ink" target="_blank" rel="noopener">Get directions</a>
          <a href="/contact/" class="btn btn-line text-ink">Contact details</a>
        </div>
      </div>
      <div class="md:col-span-6 md:col-start-7" data-reveal style="--d:.1s">
        <iframe
          title="Map showing Kirby and Teen on Blaauwberg Road, Table View"
          src={site.mapsEmbed}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="aspect-[4/3] w-full border-0 grayscale-[0.6] sepia-[0.2]"></iframe>
      </div>
    </div>
  </section>

  <Faq faqs={faqs} />
  <CtaBand />
</Base>
