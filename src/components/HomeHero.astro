---
import {Image} from 'astro:assets';
import {photo} from '../lib/photos';

interface Props {
  lines: {t: string; i?: boolean}[];
  eyebrow: string;
  body: string;
  slides: string[];
}
const {lines, eyebrow, body, slides} = Astro.props;
---

<section data-hero class="relative h-svh min-h-[620px] overflow-hidden bg-ink text-paper">
  <div data-stage class="absolute inset-0 origin-center will-change-transform">
    {
      slides.map((slug, i) => {
        const p = photo(slug);
        return (
          <div class:list={['slide absolute inset-0 overflow-hidden', i === 0 && 'is-active']}>
            <Image
              src={p.src}
              alt={i === 0 ? p.alt : ''}
              widths={[640, 1024, 1600]}
              sizes="100vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              class="h-full w-full object-cover"
            />
          </div>
        );
      })
    }
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgb(26_21_18/0.72),rgb(26_21_18/0.25)_60%,rgb(26_21_18/0.1))]"></div>
    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-[linear-gradient(0deg,rgb(26_21_18/0.55),transparent)]"></div>

    <div class="absolute inset-0 mx-auto max-w-[1680px] px-5 pt-[clamp(110px,15vh,150px)] md:px-14">
      <p class="caps text-paper/80">{eyebrow}</p>
      <h1 class="display mt-5 text-[clamp(52px,7.6vw,138px)] drop-shadow-[0_4px_30px_rgb(0_0_0/0.35)]">
        {lines.map((l, i) => <span class:list={['block', l.i && 'it', i === 0 && 'pl-[1.6em]']}>{l.t}</span>)}
      </h1>
      <p class="caps mt-10 ml-[clamp(0px,19vw,330px)] max-w-[340px] text-[13px] text-paper/90 max-md:ml-0">{body}</p>
    </div>
  </div>
</section>

<script>
  import {bindHeroes} from '../lib/hero';
  bindHeroes();
</script>
