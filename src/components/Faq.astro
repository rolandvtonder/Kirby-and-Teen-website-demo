---
import type {Faq} from '../data/services';
interface Props {
  faqs: Faq[];
  title?: string;
  id?: string;
}
const {faqs, title = 'Questions, answered', id = 'faq'} = Astro.props;
---

<section class="bg-sand py-24 md:py-32" aria-labelledby={`${id}-title`}>
  <div class="mx-auto grid max-w-[1680px] gap-12 px-5 md:grid-cols-12 md:px-14">
    <div class="md:col-span-4" data-reveal>
      <p class="caps text-muted">FAQ</p>
      <h2 id={`${id}-title`} class="display mt-4 text-[clamp(40px,4.4vw,72px)]">{title}</h2>
    </div>
    <div class="md:col-span-7 md:col-start-6">
      {
        faqs.map((f, i) => (
          <details class="faq group border-t border-ink/15 last:border-b" data-reveal style={`--d:${i * 0.05}s`}>
            <summary class="flex min-h-14 list-none items-center justify-between gap-6 py-5 text-[19px] font-medium [&::-webkit-details-marker]:hidden">
              {f.q}
              <span aria-hidden="true" class="text-2xl leading-none text-cocoa transition-transform duration-500 group-open:rotate-45">+</span>
            </summary>
            <p class="max-w-[62ch] pb-6 text-muted">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
